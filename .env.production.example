# These are examples only. Later the real file .env.production will contain the actual passwords and domains and must not be committed..

# Application database
APP_DB_NAME=room_booking
APP_DB_USER=room_booking
APP_DB_PASSWORD=change-me

# Keycloak database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak administrator
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Public URLs
PUBLIC_FRONTEND_URL=https://booking.example.com
PUBLIC_API_URL=https://api.booking.example.com
PUBLIC_KEYCLOAK_URL=https://auth.booking.example.com

# Keycloak
KEYCLOAK_REALM=room-booking
KEYCLOAK_CLIENT_ID=room-booking-frontend